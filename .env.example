# Kopia file ini jadi .env, lalu isi nilainya
DJANGO_SECRET_KEY=ganti-dengan-string-acak-panjang
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# sqlite (default) atau mysql
DB_ENGINE=sqlite
DB_NAME=smdpd
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
# Password awal user admin (dipakai perintah seed_inisial). Kosong = dibuat acak lalu ditampilkan.
ADMIN_PASSWORD=

# ── Seguransa (produksaun, DJANGO_DEBUG=False) ──
# Minutu la uza to'o sesaun sai automátiku
SESSION_IDLE_MINUTES=120
# 2FA obrigatóriu ba Admin, Presidente no Sekretaria Nasionál
DJANGO_2FA_WAJIBA=True
# Se hela hodi proxy/nginx ho HTTPS: fiar X-Forwarded-For/Proto (IP loos iha log no lokdaun)
DJANGO_TRUST_PROXY=False
# Redireciona HTTP -> HTTPS no HSTS (segundu)
DJANGO_SSL_REDIRECT=True
DJANGO_HSTS_SECONDS=31536000
# Muda URL admin Django (la uza 'admin/')
DJANGO_ADMIN_URL=admin/
